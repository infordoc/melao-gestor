# Copie este arquivo para .env e preencha os valores
# Usado por backend e docker-compose

# Banco de dados
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_PASSWORD=melao123

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=mude-esta-secret-em-producao
AUTH_URL=http://localhost:3000

# URL do frontend (dev: Vite, prod: mesmo domínio do backend)
FRONTEND_URL=http://localhost:5173

# Evolution API
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=sua-chave-da-evolution-api
EVOLUTION_WEBHOOK_SECRET=string_secreta_minimo_32_chars

# Ambiente
NODE_ENV=development
PORT=3000
